{
  "schemaVersion": 1,
  "id": "voxyvk",
  "version": "${version}",
  "custom": {
    "commit": "${commit}",
    "buildtime": "${buildtime}"
  },
  "name": "VoxyVK",
  "description": "Far distance rendering mod with Vulkan/MoltenVK support. Maintained fork of Voxy by MCRcortex (from PR-614).",
  "authors": [
    "MCRcortex (Original Author - All Rights Reserved)",
    "KalebGore28 (Fork Maintainer)"
  ],
  "contact": {
    "homepage": "https://github.com/KalebGore28/voxy-vulkan",
    "issues": "https://github.com/KalebGore28/voxy-vulkan/issues",
    "sources": "https://github.com/KalebGore28/voxy-vulkan"
  },
  "license": "All-Rights-Reserved (Copyright © 2025 MCRcortex)",
  "icon": "assets/voxy/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "me.cortex.voxy.client.VoxyClient"
    ],
    "modmenu": [
      "me.cortex.voxy.client.config.ModMenuIntegration"
    ],
    "sodium:config_api_user": [
      "me.cortex.voxy.client.config.VoxyConfigMenu"
    ],
    "main": [
      "me.cortex.voxy.commonImpl.VoxyCommon"
    ]
  },
  "mixins": [
    {
      "config": "client.voxy.mixins.json",
      "environment": "client"
    },
    "common.voxy.mixins.json"
  ],
  "depends": {
    "minecraft": "${allowed_mc_version}",
    "fabricloader": ">=0.14.22",
    "fabric-api": ">=0.91.1",
    "sodium": "${allowed_sodium_versions}"
  },
  "breaks": {
    "voxyworldgenv2": "=2.2.2"
  },
  "accessWidener": "voxy.accesswidener"
}
